QMainWindow,QDialog{background:#15171c;color:#e8ecf3;font-family:'Segoe UI';font-size:12px}
QWidget{color:#e8ecf3;font-family:'Segoe UI';font-size:12px}
QFrame#topbar{background:#1c1f25;border-bottom:1px solid #333842}
QFrame#panel{background:#1b1e24;border:1px solid #333842;border-radius:7px}
QLabel#brand{font-size:14px;font-weight:700;letter-spacing:2px;color:#f0f4fb}
QLabel#section{font-size:11px;font-weight:600;letter-spacing:1px;color:#aab4c3}
QLabel#muted{color:#a6b0bf}
QLabel#hero{font-size:40px;font-weight:600;color:#ecf1fa}
QLabel#notice{background:#272b34;color:#cbd8ed;border:1px solid #465168;border-radius:4px;padding:7px 12px}
QPushButton,QToolButton{background:#292e38;color:#e8edf5;border:1px solid #404856;border-radius:5px;padding:7px 11px;font-weight:500;min-height:17px}
QPushButton:hover,QToolButton:hover{background:#364152;border-color:#63748e}
QPushButton:pressed,QToolButton:pressed{background:#202631}
QPushButton:disabled{color:#88909e;background:#23262d;border-color:#323742}
QPushButton:focus,QToolButton:focus,QComboBox:focus,QLineEdit:focus,QListWidget:focus{border:1px solid #6ab2ff}
QPushButton#primary{background:#347bd1;border:1px solid #6da6ee;color:#ffffff;font-weight:600}
QPushButton#primary:hover{background:#438ce2}
QPushButton#primary:disabled{background:#273b55;border-color:#394b62;color:#98adc6}
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox{background:#11151b;border:1px solid #424b5b;border-radius:5px;padding:7px;color:#edf2fb;selection-background-color:#345d90}
QComboBox::drop-down{border:0;width:20px}QComboBox QAbstractItemView{background:#242a34;color:#eff4fc;selection-background-color:#354c69}
QTreeWidget,QListWidget{background:transparent;border:0;outline:0;color:#d9e0eb}
QTreeWidget::item{padding:5px 0}QTreeWidget::item:selected,QListWidget::item:selected{background:#2c3a4d}
QListWidget::item{padding:7px 0;border-bottom:1px solid #292f39}
QHeaderView::section{background:#20252d;border:0;color:#9daabd;padding:5px}
QTabWidget::pane{border:1px solid #333b48;background:#1a1e25}QTabBar::tab{background:#20252e;color:#b2bfd0;padding:9px 18px;border:1px solid #333b48}QTabBar::tab:selected{background:#2a3d56;color:#f5f8ff}
QProgressBar{border:0;border-radius:2px;background:#313844;max-height:4px;min-height:4px;color:transparent}QProgressBar::chunk{background:#61a8ff;border-radius:2px}
QScrollArea{border:0;background:#111318}QScrollBar:vertical{background:#1d222b;width:8px}QScrollBar::handle:vertical{background:#4c5667;min-height:30px;border-radius:4px}QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{height:0}QSplitter::handle{background:#15171c;width:7px}
QCheckBox{spacing:8px}QCheckBox::indicator{width:15px;height:15px;border:1px solid #6e7d92;border-radius:3px;background:#202631}QCheckBox::indicator:checked{background:#4b91e6;border-color:#91beff}
QStatusBar{background:#1b2028;color:#adbbcd}QToolTip{background:#303a49;color:#f2f6fd;border:1px solid #667a97;padding:5px}
QFrame#focusdock{background:#1c2028;border-top:1px solid #3a4351}
QFrame#focusdock QPushButton,QFrame#focusdock QComboBox,QFrame#focusdock QLineEdit{padding:5px 8px;min-height:17px}
QFrame#focusdock QLabel{font-size:11px}