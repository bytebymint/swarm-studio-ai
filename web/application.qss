QMainWindow,QDialog{background:#101619;color:#e8ecf3;font-family:'Segoe UI';font-size:12px}
QWidget{color:#e8ecf3;font-family:'Segoe UI';font-size:12px}
QFrame#topbar{background:#182024;border-bottom:1px solid #303c41}
QFrame#panel{background:#171f23;border:1px solid #303c41;border-radius:7px}
QLabel#brand{font-size:14px;font-weight:700;letter-spacing:2px;color:#f0f4fb}
QLabel#section{font-size:11px;font-weight:600;letter-spacing:1px;color:#aab4c3}
QLabel#muted{color:#a6b0bf}
QLabel#hero{font-size:40px;font-weight:600;color:#ecf1fa}
QLabel#notice{background:#272b34;color:#cbd8ed;border:1px solid #465168;border-radius:4px;padding:7px 12px}
QPushButton,QToolButton{background:#1d282d;color:#e8edf5;border:1px solid #34444a;border-radius:7px;padding:7px 11px;font-weight:500;min-height:17px}
QPushButton:hover,QToolButton:hover{background:#2a3a40;border-color:#718d87}
QPushButton:pressed,QToolButton:pressed{background:#152025}
QPushButton:disabled{color:#88909e;background:#23262d;border-color:#323742}
QPushButton:focus,QToolButton:focus,QComboBox:focus,QLineEdit:focus,QListWidget:focus{border:1px solid #6ab2ff}
QPushButton#primary{background:#b5dfce;border:1px solid #d0ecdf;color:#10251e;font-weight:600}
QPushButton#primary:hover{background:#c8eadc}
QPushButton#primary:disabled{background:#2b433c;border-color:#49675b;color:#9fb4ad}
QLineEdit,QComboBox,QSpinBox,QDoubleSpinBox{background:#111a1e;border:1px solid #34454b;border-radius:7px;padding:7px;color:#edf2fb;selection-background-color:#345d90}
QComboBox::drop-down{border:0;width:20px}QComboBox QAbstractItemView{background:#242a34;color:#eff4fc;selection-background-color:#354c69}
QTreeWidget,QListWidget{background:transparent;border:0;outline:0;color:#d9e0eb}
QTreeWidget::item{padding:5px 0}QTreeWidget::item:selected,QListWidget::item:selected{background:#2c3a4d}
QListWidget::item{padding:7px 0;border-bottom:1px solid #292f39}
QHeaderView::section{background:#20252d;border:0;color:#9daabd;padding:5px}
QTabWidget::pane{border:1px solid #333b48;background:#1a1e25}QTabBar::tab{background:#20252e;color:#b2bfd0;padding:9px 18px;border:1px solid #333b48}QTabBar::tab:selected{background:#2a3d56;color:#f5f8ff}
QProgressBar{border:0;border-radius:2px;background:#313844;max-height:4px;min-height:4px;color:transparent}QProgressBar::chunk{background:#b5dfce;border-radius:2px}
QScrollArea{border:0;background:#111318}QScrollBar:vertical{background:#1d222b;width:8px}QScrollBar::handle:vertical{background:#4c5667;min-height:30px;border-radius:4px}QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{height:0}QSplitter::handle{background:#101619;width:7px}
QCheckBox{spacing:8px}QCheckBox::indicator{width:15px;height:15px;border:1px solid #6e7d92;border-radius:3px;background:#152025}QCheckBox::indicator:checked{background:#4b91e6;border-color:#91beff}
QStatusBar{background:#1b2028;color:#adbbcd}QToolTip{background:#303a49;color:#f2f6fd;border:1px solid #667a97;padding:5px}
QFrame#focusdock{background:#131d21;border-top:1px solid #34434a}
QFrame#focusdock QPushButton,QFrame#focusdock QComboBox,QFrame#focusdock QLineEdit{padding:5px 8px;min-height:17px}
QFrame#focusdock QLabel{font-size:11px}
QMenu{background:#242a34;color:#edf2fb;border:1px solid #4a5668;padding:5px}
QMenu::item{padding:8px 22px}QMenu::item:selected{background:#355275}QMenu::separator{height:1px;background:#414b5c;margin:5px}

QWidget#workspaceLauncher{background:#101719}
QPushButton#workspaceCard{background:#172226;border:1px solid #354a46;border-radius:16px;text-align:left}
QPushButton#workspaceCard:hover{background:#1f302f;border-color:#b5dfce}
QPushButton#workspaceCard:focus{border:2px solid #b5dfce}
QLabel#workspaceCardTitle{font-size:25px;font-weight:600;color:#e8f2ee;background:transparent}
QFrame#createHeader{background:#141e22;border-bottom:1px solid #2f3d41}
QLabel#createTitle{font-size:14px;font-weight:600}
QLabel#createHeading{font-size:21px;font-weight:500;letter-spacing:-.5px}
QFrame#creationChat{background:#142024;border-right:1px solid #30413f}
QFrame#creationChat QScrollArea,QFrame#creationChat QScrollArea>QWidget>QWidget{background:transparent;border:0}
QPlainTextEdit#createPrompt{background:#10191d;color:#e6eeeb;border:1px solid #425c53;border-radius:10px;padding:10px;selection-background-color:#375c50}
QPlainTextEdit#createPrompt:focus{border-color:#b5dfce}
QLabel#createActivity{font-size:11px;color:#b4d9c8;min-height:26px}
QFrame#createToolbar{background:#121b1e;border-bottom:1px solid #2b3a3c}
QWidget#createCanvas{background:#0c1114}
